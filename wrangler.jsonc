{
  "name": "bdresult",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/institutions/*",
      "/institution/*",
      "/districts/*",
      "/upazilas/*",
      "/results/*",
      "/api/*",
      "/sitemap-institutions.xml"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bdresult_db",
      "database_id": "6f11170e-6f24-4aea-ac75-bfec6e696c82"
    }
  ]
}
